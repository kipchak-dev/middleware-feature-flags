{
    "name": "kipchak/middleware-feature-flags",
    "type": "middleware",
    "description": "Feature Flag Middleware for the Kipchak API Development Kit (ADK). Gates routes on flags from Unleash, Flagsmith or GrowthBook, with rollouts that stay sticky per consumer or API key.",
    "keywords": [
        "APIs",
        "Microservices",
        "Mamluk",
        "Feature Flags",
        "Feature Toggles",
        "Rollouts",
        "Unleash",
        "Flagsmith",
        "GrowthBook"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Middleware\\FeatureFlags\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Middleware\\FeatureFlags\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "kipchak/core": "^3.18",
        "kipchak/driver-config": "^1",
        "kipchak/driver-feature-flags": "^1.2",
        "kipchak/driver-logger": "^1",
        "kipchak/identity": "^1.3",
        "psr/http-server-middleware": "^1"
    },
    "require-dev": {
        "flagsmith/flagsmith-php-client": "^5.1",
        "growthbook/growthbook": "^2.6",
        "phpunit/phpunit": "^12",
        "unleash/client": "^2.11"
    },
    "extra": {
        "kipchak": {
            "type": "middleware",
            "config": "sample.config.php",
            "configName": "kipchak.feature-flags.middleware.php",
            "initialise": "\\Kipchak\\Middleware\\FeatureFlags\\FeatureFlags::initialise($app);",
            "after": [],
            "before": [
                "kipchak/middleware-auth-hmac",
                "kipchak/middleware-auth-jwks",
                "kipchak/middleware-auth-jwt",
                "kipchak/middleware-auth-key",
                "kipchak/middleware-opentelemetry",
                "kipchak/middleware-redaction"
            ],
            "docs": "https://kipchak.dev/docs/mw-feature-flags"
        }
    }
}
